# Backend Environment Variables
# Copy this to backend/.env for local development.
# For Vercel deployment, set these values in the Vercel dashboard instead.

# Supabase Connection
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# CORS - comma-separated list of allowed frontend origins
# Local: http://localhost:5173,http://localhost:4173
# Production: https://yourapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://yourapp.vercel.app
