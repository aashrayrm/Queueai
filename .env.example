# Frontend Environment Variables
# Copy this to .env in the project root for local development.

# API Base URL
# Local: http://localhost:8000
# Production (same Vercel project): Leave empty - requests route to /api on the same domain
# Production (separate backend project): set to your backend URL, e.g. https://your-backend-project.vercel.app
VITE_API_BASE_URL=http://localhost:8000
