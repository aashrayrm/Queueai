# ============================================================
# QueueAI — Git ignore rules
# ============================================================

# --- Node / Vite (frontend) ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Environment variables (NEVER commit secrets) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- Vercel ---
.vercel/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
